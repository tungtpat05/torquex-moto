# ==========================================
# Frontend Environment Example Configuration
# ==========================================

# API Base URL for backend REST endpoints
# For Local Dev with Vite proxy: /api/v1
# For Production / Direct Backend: http://localhost:8081/api/v1 (or your production API domain)
VITE_API_BASE_URL=/api/v1

# Direct Backend Host URL
# Used for direct redirects to backend routes (e.g. OAuth2: /oauth2/authorization/google)
VITE_BACKEND_URL=http://localhost:8081
